# Daftar RSS feed, pisahkan dengan koma. Kosongkan untuk memakai default.
RSS_FEEDS=https://radarsukabumi.com/feed/,https://mediasukabumi.id/feed/,https://sukabumisatu.com/feed/,https://sukabumihariini.id/feed/,https://jabar.antaranews.com/rss/terkini.xml,https://www.antaranews.com/rss/terkini.xml,https://rss.tempo.co/

# Telegram (wajib)
TELEGRAM_BOT_TOKEN=123456789:AAexampletoken
TELEGRAM_CHAT_ID=-1001234567890

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=120

# perilaku agen
LOOKBACK_HOURS=24
MAX_ARTICLES=40
TOP_PER_CATEGORY=3
REQUEST_TIMEOUT=15
STATE_FILE=state/seen.json

# Filter wilayah: wajib | kota | opsional
WILAYAH_MODE=wajib
WILAYAH_KEYWORDS=Sukabumi,Kota Sukabumi,Pemkot Sukabumi,Wali Kota Sukabumi,DPRD Sukabumi,Polres Sukabumi,Baros,Cibeureum,Cikole,Citamiang,Gunungpuyuh,Lembursitu,Warudoyong
WILAYAH_PRIORITAS=Kota Sukabumi,Pemkot Sukabumi,Wali Kota Sukabumi,DPRD Kota Sukabumi,Polres Sukabumi Kota,Baros,Cibeureum,Cikole,Citamiang,Gunungpuyuh,Lembursitu,Warudoyong

# Halaman website HTML biasa (bukan RSS), pisahkan dengan koma
HTML_PAGES=https://www.sukabumiupdate.com/
HTML_MAX_LINKS=12
