# Daftar RSS feed, pisahkan dengan koma. Kosongkan untuk memakai default.
RSS_FEEDS=https://www.antaranews.com/rss/terkini.xml,https://rss.tempo.co/,https://www.sindonews.com/feed,https://feeds.bbci.co.uk/indonesia/news/rss.xml

# Telegram (wajib)
TELEGRAM_BOT_TOKEN=123456789:AAexampletoken
TELEGRAM_CHAT_ID=-1001234567890

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=120

# perilaku agen
LOOKBACK_HOURS=24
MAX_ARTICLES=40
TOP_PER_CATEGORY=3
REQUEST_TIMEOUT=15
STATE_FILE=state/seen.json
